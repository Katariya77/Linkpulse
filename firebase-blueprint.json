{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing reputation metrics, trust score, and identity information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "trustScore": { "type": "number" },
        "referralCode": { "type": "string" },
        "referralXp": { "type": "number" },
        "referralsCount": { "type": "number" },
        "referredBy": { "type": "string" },
        "exchangesCompleted": { "type": "number" },
        "dwellComplianceRate": { "type": "number" },
        "ratingAverage": { "type": "number" },
        "onlineStatus": { "type": "string", "enum": ["online", "busy", "offline"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "trustScore"]
    },
    "ExchangeSession": {
      "title": "ExchangeSession",
      "description": "A 1-on-1 link exchange room session between two peers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomCode": { "type": "string" },
        "packageType": { "type": "string", "enum": ["5x5", "10x10"] },
        "dwellTimeSeconds": { "type": "number" },
        "status": { "type": "string", "enum": ["setup", "active", "completed", "disputed", "forfeited"] },
        "userId": { "type": "string" },
        "partnerId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "roomCode", "packageType", "status", "userId"]
    },
    "TrustLedgerEntry": {
      "title": "TrustLedgerEntry",
      "description": "Audit record of trust score deltas earned or penalized.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "delta": { "type": "number" },
        "resultingScore": { "type": "number" },
        "category": { "type": "string", "enum": ["dwell_compliance", "speed_bonus", "milestone", "penalty", "dispute", "manual_adjustment", "referral_bonus"] },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "delta", "resultingScore", "category", "reason"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Invitation and referral reward tracking linking referrers with invited peers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referrerId": { "type": "string" },
        "referrerEmail": { "type": "string" },
        "referrerCode": { "type": "string" },
        "referredUserId": { "type": "string" },
        "referredUsername": { "type": "string" },
        "referredAvatar": { "type": "string" },
        "referralXpAwarded": { "type": "number" },
        "trustScoreBoostAwarded": { "type": "number" },
        "status": { "type": "string", "enum": ["joined", "verified", "active_exchange"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "referrerId", "referrerCode", "referredUserId", "referralXpAwarded", "trustScoreBoostAwarded", "status"]
    },
    "IPCooldownRecord": {
      "title": "IPCooldownRecord",
      "description": "Cooldown record preventing duplicate exchanges with the same partner IP within the cooldown window.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "partnerId": { "type": "string" },
        "partnerUsername": { "type": "string" },
        "partnerIp": { "type": "string" },
        "initiatedAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "userId", "partnerId", "expiresAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application configuration including tab visibility controls.",
      "type": "object",
      "properties": {
        "hiddenTabs": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "PremiumSubscription": {
      "title": "PremiumSubscription",
      "description": "Active premium subscription records for pro users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "username": { "type": "string" },
        "userAvatar": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "cancelled", "expired"] },
        "activatedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "planId", "price", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile documents keyed by Firebase Auth UID."
    },
    "/premium_subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/PremiumSubscription" },
      "description": "Premium tier subscribers tracking 10rs/mo plans."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ExchangeSession" },
      "description": "Exchange session documents tracking synchronized link verification rooms."
    },
    "/trust_ledger/{entryId}": {
      "schema": { "$ref": "#/entities/TrustLedgerEntry" },
      "description": "Trust score modification log entries."
    },
    "/cooldowns/{cooldownId}": {
      "schema": { "$ref": "#/entities/IPCooldownRecord" },
      "description": "Cooldown tracking per user and partner."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global system configurations including tab visibility settings."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/Referral" },
      "description": "Referral tracking records linking referrers with invited creators."
    }
  }
}
