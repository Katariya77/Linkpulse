rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profiles collection
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId);
      allow update: if isSignedIn() && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    // Exchange sessions collection
    match /sessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(sessionId);
    }

    // Trust ledger audit trail
    match /trust_ledger/{entryId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(entryId);
      allow update, delete: if false; // Immutable audit log
    }

    // Cooldown records collection
    match /cooldowns/{cooldownId} {
      allow get, list, create, update, delete: if isSignedIn() && isValidId(cooldownId);
    }

    // Application settings and tab access configuration
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(settingId);
      allow delete: if false;
    }

    // Premium subscriptions collection
    match /premium_subscriptions/{subscriptionId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(subscriptionId);
      allow delete: if isSignedIn();
    }

    // Referrals and invitations collection
    match /referrals/{referralId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(referralId);
      allow delete: if isSignedIn();
    }

    // Connection validation test endpoint
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
